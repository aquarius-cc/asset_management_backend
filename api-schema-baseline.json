openapi: 3.0.3
info:
  title: 资产管理系统 API
  version: 1.0.0
  description: 资产管理系统接口文档（支持 JWT 认证、资产/合同/仓库等模块）
paths:
  /api/assets/asset-classifications/:
    get:
      operationId: assets_asset_classifications_list
      description: 资产分类管理视图集
      parameters:
      - name: ordering
        required: false
        in: query
        description: Which field to use when ordering the results.
        schema:
          type: string
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: search
        required: false
        in: query
        description: A search term.
        schema:
          type: string
      tags:
      - assets
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedAssetClassificationList'
          description: ''
    post:
      operationId: assets_asset_classifications_create
      description: 资产分类管理视图集
      tags:
      - assets
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/AssetClassificationRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/AssetClassificationRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/AssetClassificationRequest'
        required: true
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AssetClassification'
          description: ''
  /api/assets/asset-classifications/{id}/:
    get:
      operationId: assets_asset_classifications_retrieve
      description: 资产分类管理视图集
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        description: A unique integer value identifying this 资产分类管理.
        required: true
      tags:
      - assets
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AssetClassification'
          description: ''
    put:
      operationId: assets_asset_classifications_update
      description: 资产分类管理视图集
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        description: A unique integer value identifying this 资产分类管理.
        required: true
      tags:
      - assets
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/AssetClassificationRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/AssetClassificationRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/AssetClassificationRequest'
        required: true
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AssetClassification'
          description: ''
    patch:
      operationId: assets_asset_classifications_partial_update
      description: 资产分类管理视图集
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        description: A unique integer value identifying this 资产分类管理.
        required: true
      tags:
      - assets
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedAssetClassificationRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PatchedAssetClassificationRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatchedAssetClassificationRequest'
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AssetClassification'
          description: ''
    delete:
      operationId: assets_asset_classifications_destroy
      description: 资产分类管理视图集
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        description: A unique integer value identifying this 资产分类管理.
        required: true
      tags:
      - assets
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '204':
          description: No response body
  /api/assets/asset-types/:
    get:
      operationId: assets_asset_types_list
      description: 资产类型管理视图集
      parameters:
      - in: query
        name: asset_type_category
        schema:
          type: string
          nullable: true
          title: 资产分类类型分类
          enum:
          - hardware
          - other
          - software
        description: |-
          * `hardware` - 硬件
          * `software` - 软件
          * `other` - 其他
      - name: ordering
        required: false
        in: query
        description: Which field to use when ordering the results.
        schema:
          type: string
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: search
        required: false
        in: query
        description: A search term.
        schema:
          type: string
      tags:
      - assets
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedAssetTypeList'
          description: ''
    post:
      operationId: assets_asset_types_create
      description: 资产类型管理视图集
      tags:
      - assets
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/AssetTypeRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/AssetTypeRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/AssetTypeRequest'
        required: true
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AssetType'
          description: ''
  /api/assets/asset-types/{asset_type_code}/:
    get:
      operationId: assets_asset_types_retrieve
      description: 资产类型管理视图集
      parameters:
      - in: path
        name: asset_type_code
        schema:
          type: string
          title: 资产类型编码
        required: true
      tags:
      - assets
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AssetType'
          description: ''
    put:
      operationId: assets_asset_types_update
      description: 资产类型管理视图集
      parameters:
      - in: path
        name: asset_type_code
        schema:
          type: string
          title: 资产类型编码
        required: true
      tags:
      - assets
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/AssetTypeRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/AssetTypeRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/AssetTypeRequest'
        required: true
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AssetType'
          description: ''
    patch:
      operationId: assets_asset_types_partial_update
      description: 资产类型管理视图集
      parameters:
      - in: path
        name: asset_type_code
        schema:
          type: string
          title: 资产类型编码
        required: true
      tags:
      - assets
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedAssetTypeRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PatchedAssetTypeRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatchedAssetTypeRequest'
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AssetType'
          description: ''
    delete:
      operationId: assets_asset_types_destroy
      description: 资产类型管理视图集
      parameters:
      - in: path
        name: asset_type_code
        schema:
          type: string
          title: 资产类型编码
        required: true
      tags:
      - assets
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '204':
          description: No response body
  /api/assets/assets/:
    get:
      operationId: assets_assets_list
      description: 资产管理视图集
      parameters:
      - in: query
        name: asset_status
        schema:
          type: string
          nullable: true
          title: 资产状态
          enum:
          - damaged
          - newly
          - used
          - waste
        description: |-
          * `newly` - 新增资产
          * `used` - 已用资产
          * `damaged` - 待报废资产
          * `waste` - 已报废资产
      - in: query
        name: asset_storage_code
        schema:
          type: string
          title: 仓库编码
      - in: query
        name: asset_type
        schema:
          type: string
          title: 资产类型编码
      - name: ordering
        required: false
        in: query
        description: Which field to use when ordering the results.
        schema:
          type: string
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: search
        required: false
        in: query
        description: A search term.
        schema:
          type: string
      tags:
      - assets
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedAssetDetailList'
          description: ''
    post:
      operationId: assets_assets_create
      description: 资产管理视图集
      summary: 创建资产
      tags:
      - assets
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/AssetRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/AssetRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/AssetRequest'
        required: true
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Asset'
          description: 创建成功
        '400':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorResponse'
          description: 参数错误（必填字段缺失或格式错误）
        '401':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorResponse'
          description: 未授权（Token 缺失或无效）
  /api/assets/assets/{asset_code}/:
    get:
      operationId: assets_assets_retrieve
      description: 资产管理视图集
      parameters:
      - in: path
        name: asset_code
        schema:
          type: string
          title: 资产编码
        required: true
      tags:
      - assets
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AssetDetail'
          description: ''
    put:
      operationId: assets_assets_update
      description: 资产管理视图集
      parameters:
      - in: path
        name: asset_code
        schema:
          type: string
          title: 资产编码
        required: true
      tags:
      - assets
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/AssetRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/AssetRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/AssetRequest'
        required: true
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Asset'
          description: ''
    patch:
      operationId: assets_assets_partial_update
      description: 资产管理视图集
      parameters:
      - in: path
        name: asset_code
        schema:
          type: string
          title: 资产编码
        required: true
      tags:
      - assets
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedAssetRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PatchedAssetRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatchedAssetRequest'
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Asset'
          description: ''
    delete:
      operationId: assets_assets_destroy
      description: 资产管理视图集
      parameters:
      - in: path
        name: asset_code
        schema:
          type: string
          title: 资产编码
        required: true
      tags:
      - assets
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '204':
          description: No response body
  /api/assets/assets/{asset_code}/change_status/:
    post:
      operationId: assets_assets_change_status_create
      description: 更改资产状态
      parameters:
      - in: path
        name: asset_code
        schema:
          type: string
          title: 资产编码
        required: true
      tags:
      - assets
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/AssetRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/AssetRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/AssetRequest'
        required: true
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Asset'
          description: ''
  /api/assets/assets/combined_details/:
    get:
      operationId: assets_assets_combined_details_retrieve
      description: 获取组合资产详情
      tags:
      - assets
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Asset'
          description: ''
  /api/assets/assets/search_available/:
    get:
      operationId: assets_assets_search_available_retrieve
      description: 搜索可出库的资产
      tags:
      - assets
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Asset'
          description: ''
  /api/assets/assets/search_by_name/{name}/:
    get:
      operationId: assets_assets_search_by_name_list
      description: 资产管理视图集
      parameters:
      - in: query
        name: asset_status
        schema:
          type: string
          nullable: true
          title: 资产状态
          enum:
          - damaged
          - newly
          - used
          - waste
        description: |-
          * `newly` - 新增资产
          * `used` - 已用资产
          * `damaged` - 待报废资产
          * `waste` - 已报废资产
      - in: query
        name: asset_storage_code
        schema:
          type: string
          title: 仓库编码
      - in: query
        name: asset_type
        schema:
          type: string
          title: 资产类型编码
      - in: path
        name: name
        schema:
          type: string
        description: 资产名称（用于模糊搜索）
        required: true
      - name: ordering
        required: false
        in: query
        description: Which field to use when ordering the results.
        schema:
          type: string
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: search
        required: false
        in: query
        description: A search term.
        schema:
          type: string
      tags:
      - assets
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedAssetDetailList'
          description: ''
  /api/assets/assets/statistics/:
    get:
      operationId: assets_assets_statistics_retrieve
      description: 获取资产统计信息
      tags:
      - assets
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Asset'
          description: ''
  /api/assets/contracts/:
    get:
      operationId: assets_contracts_list
      description: 重写list方法，返回合同列表时，只返回合同编号、合同名称、合同金额、合同状态、合同类型、合同开始日期、合同结束日期、合同供应商、合同附件
      parameters:
      - in: query
        name: contract_settlment_status
        schema:
          type: string
          title: 结算状态
          enum:
          - pending
          - settled
        description: |-
          * `pending` - 待结算
          * `settled` - 已结算
      - in: query
        name: contract_type
        schema:
          type: string
          nullable: true
          title: 合同类型
          enum:
          - direct_procurement
          - information_construction
          - purchase
          - service
        description: |-
          * `purchase` - 采购合同
          * `service` - 服务合同
          * `information_construction` - 信息化建设合同
          * `direct_procurement` - 直接采购合同
      - name: ordering
        required: false
        in: query
        description: Which field to use when ordering the results.
        schema:
          type: string
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: search
        required: false
        in: query
        description: A search term.
        schema:
          type: string
      tags:
      - assets
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedContractDetailList'
          description: ''
    post:
      operationId: assets_contracts_create
      description: 合同管理视图集
      tags:
      - assets
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/ContractRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/ContractRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/ContractRequest'
        required: true
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Contract'
          description: ''
  /api/assets/contracts/{contract_code}/:
    get:
      operationId: assets_contracts_retrieve
      description: 合同管理视图集
      parameters:
      - in: path
        name: contract_code
        schema:
          type: string
          pattern: ^.*?$
        required: true
      tags:
      - assets
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ContractDetail'
          description: ''
    put:
      operationId: assets_contracts_update
      description: 合同管理视图集
      parameters:
      - in: path
        name: contract_code
        schema:
          type: string
          pattern: ^.*?$
        required: true
      tags:
      - assets
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/ContractRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/ContractRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/ContractRequest'
        required: true
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Contract'
          description: ''
    patch:
      operationId: assets_contracts_partial_update
      description: 合同管理视图集
      parameters:
      - in: path
        name: contract_code
        schema:
          type: string
          pattern: ^.*?$
        required: true
      tags:
      - assets
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedContractRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PatchedContractRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatchedContractRequest'
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Contract'
          description: ''
    delete:
      operationId: assets_contracts_destroy
      description: 合同管理视图集
      parameters:
      - in: path
        name: contract_code
        schema:
          type: string
          pattern: ^.*?$
        required: true
      tags:
      - assets
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '204':
          description: No response body
  /api/assets/contracts/{contract_code}/payment_record/:
    post:
      operationId: assets_contracts_payment_record_create
      description: 添加付款记录
      parameters:
      - in: path
        name: contract_code
        schema:
          type: string
          pattern: ^.*?$
        required: true
      tags:
      - assets
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/ContractRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/ContractRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/ContractRequest'
        required: true
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Contract'
          description: ''
  /api/assets/contracts/getcontractByname/{name}/:
    get:
      operationId: assets_contracts_getcontractByname_list
      description: |-
        根据合同名称模糊查询合同
        接口地址：GET /api/contracts/getcontractByname/{name}
      parameters:
      - in: query
        name: contract_settlment_status
        schema:
          type: string
          title: 结算状态
          enum:
          - pending
          - settled
        description: |-
          * `pending` - 待结算
          * `settled` - 已结算
      - in: query
        name: contract_type
        schema:
