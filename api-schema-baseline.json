    UserRole:
      type: object
      description: |-
        用户-角色关联序列化器

        输出字段(id/auth_user/role/role_name/role_code/data_scope/created_at)
        对齐前端 api/authusers.ts UserRole。

        写入:
        - role_id: write_only + source="role",兼容前端 {role_id} payload(D3 决策)
        - auth_user: 只读,由嵌套 URL 注入,禁止 body 写入
        - data_scope: 可选,缺省时由 RoleService 继承 Employee 部门(D1 决策)
      properties:
        id:
          type: integer
          readOnly: true
        auth_user:
          type: integer
          title: 系统账号
          description: 用户唯一标识
          readOnly: true
        role:
          type: integer
          readOnly: true
          title: 角色
        role_name:
          type: string
          readOnly: true
          description: 角色名称
        role_code:
          type: string
          readOnly: true
          description: 角色编码
        data_scope:
          readOnly: true
          description: 数据范围(由 Service 按 D1 计算)
        created_at:
          type: string
          format: date-time
          readOnly: true
          title: 创建时间
          description: 记录创建时间
      required:
      - auth_user
      - created_at
      - data_scope
      - id
      - role
      - role_code
      - role_name
    UserRoleRequest:
      type: object
      description: |-
