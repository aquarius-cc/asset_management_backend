    Department:
      type: object
      description: |-
        部门基础序列化器

        用于部门的 CRUD 操作和基础展示。

        输出字段:
        - parent: FK ID(recordcode)
        - parent_department_code: 业务编码(方便前端显示)
        - path: 物化路径
      properties:
        recordcode:
          type: string
          nullable: true
          title: 记录编码
          description: 后端生成的全局唯一编码,用于外键引用
          maxLength: 64
        department_code:
          type: string
          title: 部门编码
          description: 部门唯一标识编码
          maxLength: 20
        department_name:
          type: string
          title: 部门名称
          description: 部门显示名称
          maxLength: 100
        department_information:
          type: string
          title: 部门信息员
          description: 部门信息负责人
          maxLength: 20
        parent:
          type: string
          nullable: true
          title: 上级部门
          description: 上级部门(FK 指向 recordcode),null 表示根部门
        parent_department_code:
          type: string
          readOnly: true
          nullable: true
          description: 上级部门业务编码
        parent_name:
          type: string
          readOnly: true
          nullable: true
          description: 上级部门名称
        path:
          type: string
          title: 物化路径
          description: 从根到当前节点的完整路径,如 /DEPT-001/IT-001/DEV-001
          maxLength: 500
        level:
          type: integer
          maximum: 2147483647
          minimum: -2147483648
          title: 部门层级
          description: 部门层级:0=根部门,1=一级部门,最大 6 层
        sort_order:
          type: integer
          maximum: 2147483647
          minimum: -2147483648
          title: 排序顺序
          description: 数字越小排序越靠前,用于控制前端显示顺序
      required:
      - department_code
      - department_information
      - department_name
      - parent_department_code
      - parent_name
    DepartmentBatchSortRequest:
      type: object
      description: |-
        部门批量排序请求序列化器

