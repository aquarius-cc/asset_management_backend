    PatchedAssetTypeRequest:
      type: object
      description: |-
        资产类型序列化器

        输出字段:
        - parent: FK ID(recordcode)
        - parent_type_code: 业务编码(方便前端显示)
        - path: 物化路径
      properties:
        recordcode:
          type: string
          nullable: true
          title: 记录编码
          description: 后端生成的全局唯一编码,用于外键引用
          maxLength: 64
        type_code:
          type: string
          minLength: 1
          title: 类型编码
          description: 资产类型唯一编码(用于树形结构标识)
          maxLength: 30
        type_name:
          type: string
          minLength: 1
          title: 类型名称
          description: 资产类型的显示名称
          maxLength: 100
        parent:
          type: string
          nullable: true
          title: 父级类型
          description: 父级资产类型(FK 指向 recordcode),null 表示顶级
        path:
          type: string
          title: 物化路径
          description: 从根到当前节点的完整路径,如 /ASSETTYPE-001/IT-001/DEV-001
          maxLength: 500
        level:
          type: integer
          maximum: 2147483647
          minimum: -2147483648
          title: 层级
          description: 资产类型在树形结构中的层级,顶级为0
        type_description:
          type: string
          nullable: true
          title: 类型描述
          description: 资产类型的详细描述
        sort_order:
          type: integer
          maximum: 2147483647
          minimum: -2147483648
          title: 排序
          description: 同级资产类型之间的排序权重,数字越小越靠前
        is_active:
          type: boolean
          title: 是否启用
          description: 控制记录是否激活
    PatchedAssetUpdateRequest:
      type: object
      description: |-
        资产更新序列化器

        排除 recordcode 和 asset_code(后端自动生成,不可修改)。
        前端传入业务编码(asset_type_code/contract_code/storage_code/employee_jobcode),
        DRF SlugRelatedField 自动转换为 recordcode 存入数据库。
      properties:
        asset_name:
          type: string
          minLength: 1
          title: 资产名称
          description: 资产的名称
          maxLength: 100
        asset_purchase_price:
          type: string
          format: decimal
          pattern: ^-?\d{0,8}(?:\.\d{0,2})?$
          writeOnly: true
          title: 资产购买价格
          description: 资产采购单价(元)
        asset_purchase_number:
          type: integer
          maximum: 2147483647
          minimum: -2147483648
          title: 资产购买数量
          description: 采购数量
        asset_unit:
          type: string
          nullable: true
          title: 资产单位
          description: 计量单位:台/套/个等
          maxLength: 50
        asset_brand:
          type: string
          nullable: true
          title: 资产品牌
          description: 资产的品牌
          maxLength: 100
        asset_specification:
          type: string
          nullable: true
          title: 资产规格
          description: 资产的规格型号
          maxLength: 100
        asset_type:
          type: string
          minLength: 1
          title: 类型编码
          description: 资产类型唯一编码(用于树形结构标识)
        asset_contract:
          type: string
          minLength: 1
          title: 合同编号
          description: 合同唯一编码
          nullable: true
        asset_purchase_date:
          type: string
          format: date
          title: 资产购买日期
          description: 资产采购的日期
        asset_warranty_period:
          type: integer
          maximum: 2147483647
          minimum: -2147483648
          nullable: true
          title: 保修期(年)
          description: 资产保修期限(年)
        asset_entry_date:
          type: string
          format: date
          title: 入库日期
          description: 资产入库的日期
        asset_storage:
          type: string
          minLength: 1
          title: 仓库编码
          description: 仓库唯一编码,用于业务关联
          nullable: true
        asset_entry_person:
          type: string
          minLength: 1
          title: 员工工号
          nullable: true
        asset_applicant:
          type: string
          minLength: 1
          title: 员工工号
          nullable: true
        asset_manager:
          type: string
          minLength: 1
          title: 员工工号
          nullable: true
        asset_using_location:
          type: string
          nullable: true
          title: 资产使用地点
          description: 资产使用的地点
          maxLength: 100
        asset_current_status:
          allOf:
          - $ref: '#/components/schemas/AssetStatusEnum'
          title: 资产当前状态
          description: |-
            资产状态:在库/已回收待发放/在用/已损坏/维修中/已遗失/待报废/已报废

            * `in_store` - 在库
            * `in_use` - 在用
            * `recycled_pending` - 已回收待发放
            * `broken` - 已损坏
            * `repairing` - 维修中
            * `lost` - 已遗失
            * `damaged` - 待报废
            * `scrapped` - 已报废
        asset_description:
          type: string
          nullable: true
          title: 资产描述
          description: 资产的补充说明
    PatchedAuthUserRequest:
      type: object
      description: |-
