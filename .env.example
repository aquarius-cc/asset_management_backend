# ==================== 资产管理系统环境变量配置 ====================
# 【配置说明】复制此文件为 .env 并填写实际值
# ⚠️ .env 文件已加入 .gitignore，不会被提交到版本控制
# ==================================================================

# ==================== Django 设置 ====================
# Django 设置模块（开发环境使用 development，生产使用 production）
DJANGO_SETTINGS_MODULE=config.settings.development

# ==================== 安全配置 ====================
# 【易错点】生产环境必须修改此密钥！
# 生成方法：python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-this-to-a-real-secret-key-before-running

# 调试模式（生产环境必须设为 False）
DEBUG=True

# 允许的主机（生产环境应限制为具体域名）
# 多个域名用逗号分隔，如：localhost,127.0.0.1,your-domain.com
ALLOWED_HOSTS=localhost,127.0.0.1

# ==================== 数据库配置 ====================
# PostgreSQL 连接参数（本地开发使用）
DB_NAME=asset_management_backend
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# ==================== Redis 配置 ====================
# 生成方法：python -c "import secrets; print(secrets.token_urlsafe(32))"
REDIS_PASSWORD=change-this-to-a-real-password

# WebSocket 通道层连接
# Docker 环境：redis://:${REDIS_PASSWORD}@redis:6379/0（密码由 compose 注入）
# 本地开发：redis://localhost:6379/0（无需密码）
REDIS_URL=redis://localhost:6379/0

# ==================== CORS 配置 ====================
# 允许的跨域来源（生产环境应限制为具体前端域名）
# 多个域名用逗号分隔
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ==================== 监控 (docker-compose.monitoring.yml) ====================
# Grafana 管理员凭据(首次启动时创建,后续修改需通过 UI 或 grafana-cli)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_grafana_password

# ==================== JWT 配置（可选） ====================
# Access Token 有效期（小时），默认 2 小时
# ACCESS_TOKEN_LIFETIME=2

# Refresh Token 有效期（小时），默认 336 小时（14 天）
# REFRESH_TOKEN_LIFETIME=336

# --- Sentry 错误追踪(可选, 生产环境) ---
SENTRY_DSN=
APP_VERSION=1.0.0

# ==================== 备份配置（可选，未配置 S3_BUCKET 时仅本地保留） ====================
# ⚠️ 密钥通过本文件注入，禁止提交真实值；建议每 90 天轮换
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_REGION=ap-east-1

# ==================== 飞书告警适配器 (H-3) ====================
# 飞书群自定义机器人 webhook 地址(含 token, 勿提交真实值)
FEISHU_WEBHOOK_URL=
# 飞书机器人加签密钥(若机器人启用安全设置"加签"则必填)
FEISHU_SECRET=
