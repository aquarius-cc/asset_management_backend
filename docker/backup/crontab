# 每日凌晨 2:00 PostgreSQL 全量备份（与 08-数据备份恢复方案.md §1 对齐）
0 2 * * * /backup.sh >> /proc/1/fd/1 2>&1
# 每日 2:30 Redis RDB 快照归档(错峰; RPO=24h, 数据可重建, 非关键)
30 2 * * * /redis_backup.sh >> /proc/1/fd/1 2>&1
# 每日 3:00 媒体文件归档
0 3 * * * /media_backup.sh >> /proc/1/fd/1 2>&1
# 每周日凌晨 3:30 验证最近 7 天备份可读性
30 3 * * 0 /verify.sh >> /proc/1/fd/1 2>&1
# 每季度首日 4:00 恢复演练(取最新全量备份恢复到临时库并校验数据量)
0 4 1 */3 * /restore_test.sh "$(ls -t /data/backups/postgres/full_*.dump 2>/dev/null | head -1)" >> /proc/1/fd/1 2>&1
