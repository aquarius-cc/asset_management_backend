        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AssetCreate'
          description: ''
  /api/v1/assets/assets/{asset_code}/history/:
    get:
      operationId: v1_assets_assets_history_list
      description: 获取指定资产的完整操作历史时间线
      summary: 获取资产操作历史
      parameters:
      - in: path
        name: asset_code
        schema:
          type: string
        description: 资产编码
        required: true
      tags:
      - v1
      security:
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/AssetOperationLog'
          description: ''
        '404':
          content:
            application/json:
              schema:
                description: 资产不存在或没有操作记录
          description: ''
  /api/v1/assets/assets/{asset_code}/timeline/:
    get:
