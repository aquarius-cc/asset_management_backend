openapi: 3.0.3
info:
  title: 资产管理系统 API
  version: 1.0.0
  description: 资产管理系统接口文档(支持 JWT 认证、资产/合同/仓库等模块)
paths:
  /api/v1/assets/asset-types/:
    get:
      operationId: v1_assets_asset_types_list
      description: |-
        列表查询响应(统一格式)

        流程:
        1. 过滤查询集
        2. 如果有分页参数 → 调用分页器的 get_paginated_response(已包装 success_response)
        3. 如果无分页参数 → 手动包装 success_response
      parameters:
      - in: query
        name: level
        schema:
          type: integer
      - name: ordering
        required: false
        in: query
        description: Which field to use when ordering the results.
        schema:
          type: string
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: page_size
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      - name: search
        required: false
        in: query
        description: A search term.
        schema:
          type: string
      - in: query
        name: type_code
        schema:
          type: string
      - in: query
        name: type_name
        schema:
          type: string
      tags:
      - v1
      security:
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedAssetTypeList'
          description: ''
    post:
      operationId: v1_assets_asset_types_create
      description: |-
        创建资源响应(统一格式)

        流程:
        1. 验证请求数据
        2. 调用 perform_create 方法创建资源
        3. 返回成功响应
      tags:
      - v1
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/AssetTypeRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/AssetTypeRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/AssetTypeRequest'
      security:
      - BearerAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AssetType'
          description: ''
  /api/v1/assets/asset-types/{recordcode}/:
    get:
      operationId: v1_assets_asset_types_retrieve
      description: |-
        获取单个资源响应(统一格式)

        流程:
        1. 获取资源实例
        2. 序列化资源实例
        3. 返回成功响应
      parameters:
      - in: path
        name: recordcode
        schema:
          type: string
          title: 记录编码
          description: 后端生成的全局唯一编码,用于外键引用
        required: true
      tags:
      - v1
      security:
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AssetType'
          description: ''
    put:
      operationId: v1_assets_asset_types_update
      description: |-
        更新资源响应(统一格式)
        支持全量更新(PUT)和部分更新(PATCH)
        流程:
        1. 获取资源实例
        2. 验证请求数据
        3. 调用 perform_update 方法更新资源
        4. 返回成功响应
      parameters:
      - in: path
        name: recordcode
        schema:
          type: string
          title: 记录编码
          description: 后端生成的全局唯一编码,用于外键引用
        required: true
      tags:
      - v1
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/AssetTypeRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/AssetTypeRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/AssetTypeRequest'
      security:
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AssetType'
          description: ''
    patch:
      operationId: v1_assets_asset_types_partial_update
      description: |-
        支持 pk(数字)和 recordcode(字符串)双模式查找的 get_object()。

        子类必须设置 lookup_field = "recordcode"(或其变体如 "asset_recordcode__asset_code")。
      parameters:
      - in: path
        name: recordcode
        schema:
          type: string
          title: 记录编码
          description: 后端生成的全局唯一编码,用于外键引用
        required: true
      tags:
      - v1
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedAssetTypeRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PatchedAssetTypeRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatchedAssetTypeRequest'
      security:
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AssetType'
          description: ''
    delete:
      operationId: v1_assets_asset_types_destroy
      description: |-
        删除资源响应(统一格式)

        流程:
        1. 获取资源实例
        2. 调用 perform_destroy 方法删除资源
        3. 返回成功响应
      parameters:
      - in: path
        name: recordcode
        schema:
          type: string
          title: 记录编码
          description: 后端生成的全局唯一编码,用于外键引用
        required: true
      tags:
      - v1
      security:
      - BearerAuth: []
      responses:
        '204':
          description: No response body
  /api/v1/assets/asset-types/batch-create/:
    post:
      operationId: v1_assets_asset_types_batch_create_create
      description: |-
        支持 pk(数字)和 recordcode(字符串)双模式查找的 get_object()。

        子类必须设置 lookup_field = "recordcode"(或其变体如 "asset_recordcode__asset_code")。
      tags:
      - v1
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/AssetTypeRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/AssetTypeRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/AssetTypeRequest'
      security:
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AssetType'
          description: ''
  /api/v1/assets/asset-types/batch-delete/:
    post:
      operationId: v1_assets_asset_types_batch_delete_create
      description: |-
        支持 pk(数字)和 recordcode(字符串)双模式查找的 get_object()。

        子类必须设置 lookup_field = "recordcode"(或其变体如 "asset_recordcode__asset_code")。
      tags:
      - v1
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/AssetTypeRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/AssetTypeRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/AssetTypeRequest'
      security:
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AssetType'
          description: ''
  /api/v1/assets/assets/:
    get:
      operationId: v1_assets_assets_list
      description: |-
        列表查询响应(统一格式)

        流程:
        1. 过滤查询集
        2. 如果有分页参数 → 调用分页器的 get_paginated_response(已包装 success_response)
        3. 如果无分页参数 → 手动包装 success_response
      parameters:
      - in: query
        name: asset_current_status
        schema:
          type: string
          title: 资产当前状态
          enum:
          - broken
          - damaged
          - in_store
          - in_use
          - lost
          - recycled_pending
          - repairing
          - scrapped
        description: |-
          资产状态:在库/已回收待发放/在用/已损坏/维修中/已遗失/待报废/已报废

          * `in_store` - 在库
          * `in_use` - 在用
          * `recycled_pending` - 已回收待发放
          * `broken` - 已损坏
          * `repairing` - 维修中
          * `lost` - 已遗失
          * `damaged` - 待报废
          * `scrapped` - 已报废
      - in: query
        name: asset_storage_recordcode
        schema:
          type: string
          nullable: true
          title: 记录编码
        description: 后端生成的全局唯一编码,用于外键引用
      - in: query
        name: asset_type_recordcode
        schema:
          type: string
          nullable: true
          title: 记录编码
        description: 后端生成的全局唯一编码,用于外键引用
      - name: ordering
        required: false
        in: query
        description: Which field to use when ordering the results.
        schema:
          type: string
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: page_size
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      - name: search
        required: false
        in: query
        description: A search term.
        schema:
          type: string
      tags:
      - v1
      security:
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedAssetListList'
          description: ''
    post:
      operationId: v1_assets_assets_create
      description: |-
        创建资源响应(统一格式)

        流程:
        1. 验证请求数据
        2. 调用 perform_create 方法创建资源
        3. 返回成功响应
      tags:
      - v1
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/AssetCreateRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/AssetCreateRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/AssetCreateRequest'
        required: true
      security:
