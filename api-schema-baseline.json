  /api/v1/assets/contracts/getcontractByname/{name}/:
    get:
      operationId: v1_assets_contracts_getcontractByname_list
      description: |-
        支持 pk(数字)和 recordcode(字符串)双模式查找的 get_object()。

        子类必须设置 lookup_field = "recordcode"(或其变体如 "asset_recordcode__asset_code")。
      parameters:
      - in: query
        name: contract_status
        schema:
          type: string
          title: 合同状态
          enum:
          - final_check
          - initial_check
          - project_finished
          - project_settlement
          - purchase_finished
          - purchasing
          - receive_check
          - settlement_done
        description: |-
          合同状态:供货中/供货完成/到货验收/初步验收/结算中/结算完成/最终验收/项目结束

          * `purchasing` - 供货中
          * `purchase_finished` - 供货完成
          * `receive_check` - 到货验收
          * `initial_check` - 初步验收
          * `project_settlement` - 结算中
          * `settlement_done` - 结算完成
          * `final_check` - 最终验收
          * `project_finished` - 项目结束
      - in: query
        name: contract_type
        schema:
          type: string
          nullable: true
          title: 合同类型
          enum:
          - direct_procurement
          - information_construction
          - service
          - tender_procurement
        description: |-
          合同类型:招标采购/服务/信息化建设/直接采购

          * `tender_procurement` - 招标采购合同
          * `service` - 服务合同
          * `information_construction` - 信息化建设合同
          * `direct_procurement` - 直接采购合同
      - in: path
        name: name
        schema:
          type: string
        required: true
      - name: ordering
        required: false
        in: query
        description: Which field to use when ordering the results.
        schema:
          type: string
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: page_size
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      - name: search
        required: false
        in: query
        description: A search term.
        schema:
          type: string
      tags:
      - v1
      security:
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedContractDetailList'
          description: ''
