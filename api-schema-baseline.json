  schemas:
    ApprovalStatusEnum:
      enum:
      - pending
      - approved
      - rejected
      type: string
      description: |-
        * `pending` - 待审批
        * `approved` - 已批准
        * `rejected` - 已拒绝
    Asset:
      type: object
      description: 资产序列化器
      properties:
        id:
          type: integer
          readOnly: true
        asset_type_name:
          type: string
          readOnly: true
        asset_classification_name:
          type: string
          readOnly: true
        storage_name:
          type: string
          readOnly: true
        contract_name:
          type: string
          readOnly: true
        contract_supplier:
          type: string
          readOnly: true
        entry_person_name:
          type: string
          readOnly: true
        manager_name:
          type: string
          readOnly: true
        asset_code:
          type: string
          title: 资产编码
          maxLength: 20
        asset_name:
          type: string
          title: 资产名称
          maxLength: 100
        asset_purchase_price:
          type: string
          format: decimal
          pattern: ^-?\d{0,8}(?:\.\d{0,2})?$
          title: 资产购买价格
        asset_purchase_number:
          type: integer
          maximum: 2147483647
          minimum: -2147483648
          title: 资产购买数量
        asset_unit:
          type: string
          nullable: true
          title: 资产单位
          maxLength: 50
        asset_brand:
          type: string
          nullable: true
          title: 资产品牌
          maxLength: 100
        asset_specification:
          type: string
          nullable: true
          title: 资产规格
          maxLength: 100
        asset_purchase_date:
          type: string
          format: date
          title: 资产购买日期
        asset_warranty_period:
          type: integer
          maximum: 2147483647
          minimum: -2147483648
          nullable: true
          title: 保修期（年）
        asset_entry_date:
          type: string
          format: date
          title: 入库日期
        asset_using_location:
          type: string
          nullable: true
          title: 资产使用地点
          maxLength: 100
