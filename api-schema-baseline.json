    PatchedContractUpdateRequest:
      type: object
      description: |-
        合同更新序列化器
        用途:update, partial_update action
        特点:写入字段,recordcode 只读
      properties:
        contract_code:
          type: string
          minLength: 1
          title: 合同编号
          description: 合同唯一编码
          maxLength: 50
        contract_name:
          type: string
          minLength: 1
          title: 合同名称
          description: 合同的完整名称
          maxLength: 200
        contract_type:
          nullable: true
          title: 合同类型
          description: |-
            合同类型:招标采购/服务/信息化建设/直接采购

            * `tender_procurement` - 招标采购合同
            * `service` - 服务合同
            * `information_construction` - 信息化建设合同
            * `direct_procurement` - 直接采购合同
          oneOf:
          - $ref: '#/components/schemas/ContractTypeEnum'
          - $ref: '#/components/schemas/BlankEnum'
          - $ref: '#/components/schemas/NullEnum'
        supplier_name:
          type: string
          nullable: true
          title: 供应商名称
          description: 供应商名称
          maxLength: 100
        contract_amount:
          type: string
          format: decimal
          pattern: ^-?\d{0,10}(?:\.\d{0,2})?$
          nullable: true
          title: 合同总金额
          description: 合同总金额(元)
        settlemented_price:
          type: string
          format: decimal
          pattern: ^-?\d{0,10}(?:\.\d{0,2})?$
          nullable: true
          title: 结算价格
          description: 最终结算金额(元)
        contract_total_quantity:
          type: integer
          maximum: 2147483647
          minimum: -2147483648
          nullable: true
          title: 合同总数量
          description: 合同约定的总数量
        contract_start_date:
          type: string
          format: date
          nullable: true
          title: 合同开始日期
          description: 合同开始日期
        contract_end_date:
          type: string
          format: date
          nullable: true
          title: 合同结束日期
          description: 合同结束日期
        contract_status:
          allOf:
          - $ref: '#/components/schemas/ContractStatusEnum'
          title: 合同状态
          description: |-
            合同状态:供货中/供货完成/到货验收/初步验收/结算中/结算完成/最终验收/项目结束

            * `purchasing` - 供货中
            * `purchase_finished` - 供货完成
            * `receive_check` - 到货验收
            * `initial_check` - 初步验收
            * `project_settlement` - 结算中
            * `settlement_done` - 结算完成
            * `final_check` - 最终验收
            * `project_finished` - 项目结束
        project_change:
          type: boolean
          title: 项目变更
          description: 是否存在项目变更
        project_change_type:
          nullable: true
          title: 变更类型
          description: |-
            变更类型:设备增加/设备减少/只涉及型号/数量增加和型号/数量减少和型号

            * `equipment_increase` - 设备增加变更
            * `equipment_decrease` - 设备减少变更
            * `model_change_only` - 只涉及型号变更
            * `quantity_increase_with_model` - 设备数量增加和型号变更
            * `quantity_decrease_with_model` - 设备数量减少和型号变更
          oneOf:
          - $ref: '#/components/schemas/ProjectChangeTypeEnum'
          - $ref: '#/components/schemas/BlankEnum'
          - $ref: '#/components/schemas/NullEnum'
        project_change_description:
          type: string
          nullable: true
          title: 变更描述
          description: 简单介绍变更内容
        receive_check_date:
          type: string
          format: date
          nullable: true
          title: 到货验收日期
          description: 到货验收日期
        initial_check_date:
          type: string
          format: date
          nullable: true
          title: 初步验收日期
          description: 初步验收日期
        final_check_date:
          type: string
          format: date
          nullable: true
          title: 最终验收日期
          description: 最终验收日期
        paid_record:
          type: string
          nullable: true
          title: 支付记录
          description: 支付记录(可存储JSON格式的支付明细)
        amount_paid:
          type: string
          format: decimal
          pattern: ^-?\d{0,10}(?:\.\d{0,2})?$
          nullable: true
          title: 已支付金额
          description: 已支付金额,默认为0
        amount_unpaid:
          type: string
          format: decimal
          pattern: ^-?\d{0,10}(?:\.\d{0,2})?$
          nullable: true
          title: 未支付金额
          description: 未支付金额(自动计算)
        contract_description:
          type: string
          nullable: true
          title: 合同描述
          description: 补充说明
        sort_order:
          type: integer
          maximum: 2147483647
          minimum: -2147483648
          title: 排序
          description: 排序字段
        is_active:
          type: boolean
          title: 是否启用
          description: 控制记录是否激活
